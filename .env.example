# Copy to .env and fill in what you need. Every value is optional; the defaults
# live in src/grounded_rag/config.py.

# Needed only for /ask and `grounded-rag ask`. Search and the benchmark run without it.
ANTHROPIC_API_KEY=

# When set, /search and /ask require this value in the X-API-Key header.
RAG_API_KEY=

# Qdrant server. Leave empty to run Qdrant embedded in the process (data/qdrant).
# docker compose sets this for the api service.
RAG_QDRANT_URL=

# Retrieval defaults.
# RAG_SEARCH_MODE=hybrid
# RAG_TOP_K=5
# RAG_CANDIDATE_K=30
# RAG_RERANK=true

# Answer generation.
# RAG_LLM_MODEL=claude-opus-5-5
# RAG_LLM_EFFORT=medium
