# Copy to .env and fill in what you need. Every value is optional; the defaults
# live in src/rag/config.py.

# Needed only for /ask and `rag ask`. Search and the benchmark run without it.
GEMINI_API_KEY=

# When set, /search and /ask require this value in the X-API-Key header.
RAG_API_KEY=

# Qdrant server, for example http://127.0.0.1:6333 (prefer the IP over "localhost").
# Leave empty to run Qdrant embedded in the process (data/qdrant).
# docker compose sets this for the api service.
RAG_QDRANT_URL=

# Retrieval defaults.
# RAG_SEARCH_MODE=hybrid
# RAG_TOP_K=5
# RAG_CANDIDATE_K=30
# RAG_RERANK=false

# Answer generation.
# RAG_LLM_MODEL=gemini-3.8-flash

# Database for the document registry and the question history. Defaults to a local
# SQLite file. For Supabase use the "Session pooler" connection string, then run
# `rag migrate` once.
# RAG_DATABASE_URL=postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres

# Supabase project. With the URL and the anon key set, users must sign in and each
# sees only their own documents. The service key also moves uploaded files into
# Supabase Storage. The service key bypasses all access rules: backend only.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
